{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mobile-web",
      "runtimeExecutable": "powershell.exe",
      "runtimeArgs": [
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/run-package-script.ps1",
        "@nestscout/mobile",
        "web"
      ],
      "port": 8081
    },
    {
      "name": "mobile-web-staging",
      "runtimeExecutable": "powershell.exe",
      "runtimeArgs": [
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/run-mobile-web-staging-preview.ps1"
      ],
      "port": 8082
    },
    {
      "name": "mobile-web-production",
      "runtimeExecutable": "powershell.exe",
      "runtimeArgs": [
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/run-mobile-web-production-preview.ps1"
      ],
      "port": 8085
    },
    {
      "name": "mobile-web-production-linux",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "set -a; . apps/mobile/.env.local; set +a; export EXPO_NO_DOTENV=1 NESTSCOUT_MOBILE_ENV_FILE=\"$PWD/apps/mobile/.env.local\" BROWSER=none; cd apps/mobile && exec node node_modules/expo/bin/cli start --web --port 8085 --clear"
      ],
      "port": 8085
    },
    {
      "name": "api-nextjs",
      "runtimeExecutable": "powershell.exe",
      "runtimeArgs": [
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/run-package-script.ps1",
        "@nestscout/api",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "mobile-web-direct",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/mobile/node_modules/expo/bin/cli",
        "start",
        "--web",
        "--port",
        "8081",
        "apps/mobile"
      ],
      "port": 8081
    }
  ]
}
