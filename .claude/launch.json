{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mobile-web",
      "runtimeExecutable": "powershell.exe",
      "runtimeArgs": [
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/run-package-script.ps1",
        "@nestscout/mobile",
        "web"
      ],
      "port": 8081
    },
    {
      "name": "mobile-web-staging",
      "runtimeExecutable": "powershell.exe",
      "runtimeArgs": [
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/run-mobile-web-staging-preview.ps1"
      ],
      "port": 8082
    },
    {
      "name": "api-nextjs",
      "runtimeExecutable": "powershell.exe",
      "runtimeArgs": [
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/run-package-script.ps1",
        "@nestscout/api",
        "dev"
      ],
      "port": 3000
    }
  ]
}
