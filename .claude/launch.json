{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mobile-web",
      "runtimeExecutable": "powershell.exe",
      "runtimeArgs": [
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/run-package-script.ps1",
        "@nestscout/mobile",
        "web"
      ],
      "port": 8081
    },
    {
      "name": "mobile-web-staging",
      "runtimeExecutable": "powershell.exe",
      "runtimeArgs": [
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/run-mobile-web-staging-preview.ps1"
      ],
      "port": 8082
    },
    {
      "name": "mobile-web-production",
      "runtimeExecutable": "powershell.exe",
      "runtimeArgs": [
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/run-mobile-web-production-preview.ps1"
      ],
      "port": 8085
    },
    {
      "name": "mobile-web-production-posix",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/preview/production-web.mjs"
      ],
      "port": 8085
    },
    {
      "name": "api-nextjs",
      "runtimeExecutable": "powershell.exe",
      "runtimeArgs": [
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/run-package-script.ps1",
        "@nestscout/api",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "mobile-web-direct",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/mobile/node_modules/expo/bin/cli",
        "start",
        "--web",
        "--port",
        "8081",
        "apps/mobile"
      ],
      "port": 8081
    },
    {
      "name": "mobile-web-mock",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/preview/cache-e2e/run.mjs",
        "--serve"
      ],
      "port": 8098
    }
  ]
}
