{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Mobile (Expo Web)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@home-services/mobile", "web"],
      "port": 8081
    },
    {
      "name": "API (Next.js)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@home-services/api", "dev"],
      "port": 3000
    },
    {
      "name": "Supabase Local Stack",
      "runtimeExecutable": "supabase",
      "runtimeArgs": ["start"],
      "port": 54321
    },
    {
      "name": "Supabase Edge Functions (mobile-api)",
      "runtimeExecutable": "supabase",
      "runtimeArgs": ["functions", "serve", "mobile-api", "--no-verify-jwt"],
      "port": 54321
    },
    {
      "name": "Turbo dev (all workspaces)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 3000
    }
  ]
}
