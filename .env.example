# Public — safe to expose to browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Mobile public config - required by Expo app.config.ts / EAS builds
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_BASE_URL=

# Local-only staging smoke helper. Keep real values in .env.local, never commit.
STAGING_ACCESS_TOKEN=

# Section 32 staging smoke harness - local only, never commit real values.
SECTION32_RUN_LIVE=
SECTION32_SUPABASE_URL=
SECTION32_API_BASE_URL=
SECTION32_SUPABASE_ANON_KEY=
SECTION32_SUPABASE_SERVICE_ROLE_KEY=
SECTION32_REPORT_PATH=
SECTION32_REQUIRE_PROVIDER=

# Local-only Supabase CLI helpers. Keep real values in shell/.env.local only.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Server-side only — NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# AI API Keys — server-side only, NEVER expose to browser
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
DEEPSEEK_API_KEY=

# Maps/geocoding provider keys - server-side only, NEVER expose to mobile
VIETMAP_API_KEY=
GOOGLE_MAPS_API_KEY=

# Kael Edge rollout flags - server-side only
KAEL_TRUST_PERPLEXITY_FILTER_ENABLED=
KAEL_OPT_SOURCE_TRUST_ENABLED=
# Smart-clarification intake-diagnosis (off = legacy hardcoded clarification)
KAEL_OPT_LLM_CLARIFICATION_ENABLED=
