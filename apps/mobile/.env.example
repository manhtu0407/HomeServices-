# Supabase — publishable key only (safe for client)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase Edge Function base URL, e.g. https://<project>.supabase.co/functions/v1/mobile-api
EXPO_PUBLIC_API_BASE_URL=

# Section 32 native recording harness - local only, never commit real values.
SECTION32_NATIVE_RUN=
SECTION32_NATIVE_CUSTOMER_EMAIL=
SECTION32_NATIVE_CUSTOMER_PASSWORD=
SECTION32_NATIVE_WORKER_EMAIL=
SECTION32_NATIVE_WORKER_PASSWORD=
SECTION32_NODE_PATH=
