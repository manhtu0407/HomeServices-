# Supabase — publishable key only (safe for client)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase Edge Function base URL, e.g. https://<project>.supabase.co/functions/v1/mobile-api
EXPO_PUBLIC_API_BASE_URL=

# Mobile crash/error reporting. DSN is a client key; keep SENTRY_AUTH_TOKEN in EAS secrets, not here.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=staging
SENTRY_ORG=
SENTRY_PROJECT=
