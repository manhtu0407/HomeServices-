{
  "$meta": {
    "name": "Kael / NestScout Design Tokens",
    "version": "2.0.0",
    "platform": "react-native",
    "source": "Customer v2.1 / Worker v5.0 verified design zips",
    "note": "Formula mint primary is #08AF9C. App-wide primary CTA gradients follow the final mint aura formula."
  },
  "color": {
    "text": {
      "primary": "#071A24",
      "strong": "#0B2F2A",
      "secondary": "#526B73",
      "muted": "#7C8F94",
      "disabled": "#B8C7C8",
      "inverse": "#FFFFFF"
    },
    "mint": {
      "white": "#F7FFFB",
      "canvas": "#FFFFFF",
      "auraSoft": "#E6F7F3",
      "auraStrong": "#C8F4EA",
      "mint50": "#E6FBF3",
      "mint100": "#D7F6EF",
      "mint300": "#8FE2D4",
      "mint500": "#31D7C2",
      "mint600": "#08AF9C",
      "mint700": "#087D72",
      "mint800": "#055B54"
    },
    "brand": {
      "ios26TabTint": "#09978C",
      "primary": "#08AF9C",
      "primaryDark": "#087D72",
      "primaryDeep": "#055B54"
    },
    "surface": {
      "base": "#FFFFFF",
      "soft": "#FAFDFC",
      "mint": "#F1FBF8",
      "raised": "#FFFFFF",
      "disabled": "#EDF3F2",
      "stroke": "#D8EBE8",
      "strokeStrong": "#B8E7DF"
    },
    "accent": {
      "aqua": "#22D1C8",
      "skyBlue": "#38BDF8",
      "deepTeal": "#0A5F63",
      "success": "#27B66D",
      "warning": "#F7B642",
      "coral": "#FF6B63",
      "destructive": "#EF4E4E",
      "lavender": "#8A78FA",
      "gold": "#FFC857"
    }
  },
  "typography": {
    "fontPolicy": {
      "family": "system",
      "resolvedOnIOS": "SF Pro",
      "androidFallback": "System",
      "webStack": "system-ui, -apple-system, BlinkMacSystemFont, sans-serif",
      "embedFontFiles": false,
      "dynamicType": true,
      "opticalSizing": "automatic",
      "targetLanguage": "vi-VN"
    },
    "roles": {
      "largeTitle": { "fontSize": 34, "lineHeight": 41, "fontWeight": "400", "letterSpacing": 0.4 },
      "title1": { "fontSize": 28, "lineHeight": 34, "fontWeight": "400", "letterSpacing": 0.38 },
      "title2": { "fontSize": 22, "lineHeight": 28, "fontWeight": "400", "letterSpacing": -0.26 },
      "title3": { "fontSize": 20, "lineHeight": 25, "fontWeight": "400", "letterSpacing": -0.45 },
      "headline": { "fontSize": 17, "lineHeight": 22, "fontWeight": "600", "letterSpacing": -0.43 },
      "body": { "fontSize": 17, "lineHeight": 22, "fontWeight": "400", "letterSpacing": -0.43 },
      "callout": { "fontSize": 16, "lineHeight": 21, "fontWeight": "400", "letterSpacing": -0.31 },
      "subheadline": { "fontSize": 15, "lineHeight": 20, "fontWeight": "400", "letterSpacing": -0.23 },
      "footnote": { "fontSize": 13, "lineHeight": 18, "fontWeight": "400", "letterSpacing": -0.08 },
      "caption1": { "fontSize": 12, "lineHeight": 16, "fontWeight": "400", "letterSpacing": 0 },
      "caption2": { "fontSize": 11, "lineHeight": 13, "fontWeight": "400", "letterSpacing": 0.06 },
      "tabularBody": { "fontSize": 17, "lineHeight": 22, "fontWeight": "400", "letterSpacing": -0.43, "fontVariant": ["tabular-nums"] }
    },
    "scale": {
      "h1": { "alias": "largeTitle", "fontSize": 34, "lineHeight": 41, "fontWeight": "400", "letterSpacing": 0.4 },
      "h2": { "alias": "title2", "fontSize": 22, "lineHeight": 28, "fontWeight": "400", "letterSpacing": -0.26 },
      "h3": { "alias": "title3", "fontSize": 20, "lineHeight": 25, "fontWeight": "400", "letterSpacing": -0.45 },
      "body": { "alias": "body", "fontSize": 17, "lineHeight": 22, "fontWeight": "400", "letterSpacing": -0.43 },
      "label": { "alias": "subheadline", "fontSize": 15, "lineHeight": 20, "fontWeight": "400", "letterSpacing": -0.23 },
      "caption": { "alias": "caption1", "fontSize": 12, "lineHeight": 16, "fontWeight": "400", "letterSpacing": 0 }
    }
  },
  "spacing": {
    "xxs": 2,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "xxl": 24,
    "xxxl": 32,
    "screenHorizontalPadding": 16,
    "screenVerticalPadding": 18,
    "cardPaddingSmall": 12,
    "cardPadding": 16,
    "cardPaddingLarge": 20,
    "sectionGap": 16,
    "componentGap": 12,
    "iconGridGap": 14
  },
  "radius": {
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 22,
    "xl": 28,
    "sheet": 34,
    "pill": 999
  },
  "component": {
    "button": {
      "primary": {
        "gradient": ["#31D7C2", "#09B29E", "#077C72"],
        "gradientStops": [0, 0.5, 1],
        "text": "#FFFFFF",
        "border": "rgba(255,255,255,0.72)",
        "height": 48,
        "radius": 22,
        "paddingX": 20
      }
    },
    "bottomNav": {
      "bg": "#FFFFFF",
      "height": 64,
      "radius": 34,
      "paddingX": 10,
      "iconSize": 22,
      "activeIcon": "#08AF9C",
      "inactiveIcon": "#7C8F94",
      "orb": {
        "bg": "#08AF9C",
        "label": "Kael",
        "size": 64,
        "outerSize": 76,
        "radius": 999,
        "separated": true,
        "iconSize": 26,
        "glyphHeight": 31,
        "glyphWidth": 34,
        "labelFontSize": 10,
        "labelLineHeight": 12,
        "paddingTop": 7,
        "paddingBottom": 6,
        "auraSize": 59,
        "auraOffsetTop": -8,
        "auraOffsetRight": -10
      }
    }
  }
}
