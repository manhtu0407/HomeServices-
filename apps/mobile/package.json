{
  "name": "@nestscout/mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:mobile": "eslint .",
    "eas:login": "pnpm dlx eas-cli@22.0.0 login",
    "eas:whoami": "pnpm dlx eas-cli@22.0.0 whoami",
    "testflight": "pnpm dlx eas-cli@22.0.0 build -p ios --profile production --auto-submit",
    "submit:ios:latest": "pnpm dlx eas-cli@22.0.0 submit -p ios --profile production --latest",
    "play:internal": "pnpm dlx eas-cli@22.0.0 build -p android --profile production --auto-submit",
    "submit:android:latest": "pnpm dlx eas-cli@22.0.0 submit -p android --profile production --latest"
  },
  "dependencies": {
    "@babel/runtime": "7.29.2",
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.8",
    "@nestscout/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.105.4",
    "@vietmap/vietmap-gl-react-native": "3.0.0",
    "expo": "~57.0.9",
    "expo-asset": "~57.0.8",
    "expo-audio": "~57.0.3",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.8",
    "expo-dev-client": "~57.0.10",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.7",
    "expo-linking": "~57.0.4",
    "expo-location": "~57.0.7",
    "expo-notifications": "~57.0.8",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-speech-recognition": "56.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-video-thumbnails": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/generator": "7.29.7",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.41",
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.2.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.3",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "private": true
}
