{
  "name": "@nestscout/mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:mobile": "eslint .",
    "eas:login": "pnpm dlx eas-cli@21.0.0 login",
    "eas:whoami": "pnpm dlx eas-cli@21.0.0 whoami",
    "testflight": "pnpm dlx eas-cli@21.0.0 build -p ios --profile production --auto-submit",
    "submit:ios:latest": "pnpm dlx eas-cli@21.0.0 submit -p ios --profile production --latest",
    "play:internal": "pnpm dlx eas-cli@21.0.0 build -p android --profile production --auto-submit",
    "submit:android:latest": "pnpm dlx eas-cli@21.0.0 submit -p android --profile production --latest"
  },
  "dependencies": {
    "@babel/runtime": "7.29.2",
    "@expo/metro-runtime": "~56.0.18",
    "@nestscout/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.105.4",
    "expo": "~56.0.17",
    "expo-asset": "~56.0.21",
    "expo-audio": "~56.0.13",
    "expo-blur": "~56.0.4",
    "expo-constants": "~56.0.22",
    "expo-glass-effect": "~56.0.4",
    "expo-image": "~56.0.11",
    "expo-image-picker": "^56.0.22",
    "expo-linking": "~56.0.16",
    "expo-location": "~56.0.22",
    "expo-notifications": "~56.0.22",
    "expo-router": "~56.2.16",
    "expo-secure-store": "~56.0.4",
    "expo-speech-recognition": "3.1.3",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "expo-video-thumbnails": "~56.0.3",
    "lottie-react-native": "~7.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-reanimated": "~4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.41",
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.2.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~56.0.4",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "private": true
}
