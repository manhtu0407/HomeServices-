{
  "name": "@home-services/mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "type-check": "tsc --noEmit",
    "eas:login": "npx eas-cli@latest login",
    "eas:whoami": "npx eas-cli@latest whoami",
    "testflight": "npx eas-cli@latest build -p ios --profile production --auto-submit",
    "submit:ios:latest": "npx eas-cli@latest submit -p ios --profile production --latest",
    "play:internal": "npx eas-cli@latest build -p android --profile production --auto-submit",
    "submit:android:latest": "npx eas-cli@latest submit -p android --profile production --latest"
  },
  "dependencies": {
    "@home-services/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.105.4",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-image": "~3.0.11",
    "expo-image-picker": "^17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "metro-runtime": "0.83.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.5.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "~19.1.17",
    "@types/react-dom": "~19.1.11",
    "typescript": "~5.9.2"
  },
  "private": true
}
