# Public — safe to expose to browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Mobile public config - required by Expo app.config.ts / EAS builds
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_BASE_URL=

# Local-only staging smoke helper. Keep real values in .env.local, never commit.
STAGING_ACCESS_TOKEN=

# Kael evaluation harness. Live mode is explicit and staging/local only.
KAEL_EVAL_MODE=
KAEL_EVAL_RUN_LIVE=
KAEL_EVAL_MOBILE_API_URL=
KAEL_EVAL_BEARER_TOKEN=
KAEL_EVAL_ANON_KEY=
KAEL_EVAL_REQUEST_TIMEOUT_MS=
KAEL_EVAL_FIXTURE_PATH=
KAEL_EVAL_KNOWLEDGE_FIXTURE_PATH=
KAEL_EVAL_REPORT_PATH=

# Set exactly yes only when a disposable smoke user must be retained for inspection.
KEEP_USER=

# Source-trust research. Live calls remain explicit and output must stay in the workspace.
KAEL_B3_SOURCE_AUDIT_LIVE=
SOURCE_TRUST_RUN_LIVE=
SOURCE_TRUST_OUTPUT_DIR=
SOURCE_RESEARCH_TIMEOUT_MS=
PERPLEXITY_API_URL=

# Privileged F26 harnesses. Keep all credentials in the local shell only.
F26_RUN_AB_PRICESYNTH=
F26_RUN_SOURCE_TRUST_SMOKE=
F26_RUN_PRODUCTION=
F26_SUPABASE_URL=
F26_API_BASE_URL=
F26_SUPABASE_ANON_KEY=
F26_SUPABASE_SERVICE_ROLE_KEY=
F26_ARTIFACTS_SINCE=

# P15 mutable staging harness and its staging-linked cleanup workdir.
P15_RUN_LIVE=
P15_SUPABASE_URL=
P15_API_BASE_URL=
P15_SUPABASE_ANON_KEY=
P15_SUPABASE_SERVICE_ROLE_KEY=
P15_SUPABASE_CLI=
P15_SUPABASE_WORKDIR=
P15_REPORT_PATH=

# Q1 mutable staging baseline and bounded provider probes.
Q1_BASELINE_RUN_LIVE=
Q1_SUPABASE_URL=
Q1_API_BASE_URL=
Q1_SUPABASE_ANON_KEY=
Q1_SUPABASE_SERVICE_ROLE_KEY=
Q1_SAMPLE_SIZE=
Q1_BASELINE_REPORT_PATH=
Q1_PURPOSE_PROBES=
Q1_FETCH_RETRIES=
Q1_USE_PHOTOS=

# Section 32 staging smoke harness - local only, never commit real values.
SECTION32_RUN_LIVE=
SECTION32_SUPABASE_URL=
SECTION32_API_BASE_URL=
SECTION32_SUPABASE_ANON_KEY=
SECTION32_SUPABASE_SERVICE_ROLE_KEY=
SECTION32_REPORT_PATH=
SECTION32_REQUIRE_PROVIDER=

# Local-only Supabase CLI helpers. Keep real values in shell/.env.local only.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Server-side only — NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# AI API Keys — server-side only, NEVER expose to browser
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
DEEPSEEK_API_KEY=

# Maps/geocoding provider keys - server-side only, NEVER expose to mobile
VIETMAP_API_KEY=
GOOGLE_MAPS_API_KEY=

# Server-only readiness attestations; enable only after matching native/provider proof.
NESTSCOUT_ANDROID_FCM_V1_READY=
NESTSCOUT_IOS_APNS_READY=
NESTSCOUT_PUSH_RECEIPT_RECONCILER_READY=

# Payments - Supabase Edge only, NEVER expose to mobile
NESTSCOUT_SEPAY_VIETQR_ENABLED=
SEPAY_VIETQR_BANK_CODE=
SEPAY_VIETQR_ACCOUNT_NUMBER=
SEPAY_VIETQR_ACCOUNT_HOLDER=
SEPAY_WEBHOOK_SECRET=
NESTSCOUT_PLATFORM_MANUAL_BANK_ENABLED=
PLATFORM_MANUAL_BANK_CODE=
PLATFORM_MANUAL_BANK_ACCOUNT_NUMBER=
PLATFORM_MANUAL_BANK_ACCOUNT_HOLDER=
# Shared secret for payment-maintainer. Store the same value in Vault as
# payment_maintainer_secret before scheduling the maintainer.
PAYMENT_MAINTAINER_SECRET=

# Kael Edge rollout flags - server-side only
# Deterministic post-A14 learning promotion; unset/false = observe-only.
KAEL_LEARNING_AUTOPROMOTE_ENABLED=
# Dry run for the above: the gate still runs and its decision is written to
# kael_rule_lifecycle_log, but no rule is promoted. Read the logged decisions for a few
# weeks of real reviews before trusting autopromote.
KAEL_LEARNING_SHADOW_MODE=
# Shared secret for the scheduled kael-learning-monitor Edge Function. The pg_cron job
# reads the same value from the Vault secret kael_learning_monitor_secret; the job stays
# uninstalled until both that and project_url exist.
KAEL_LEARNING_MONITOR_SECRET=
# Shared secret for the scheduled saved-worker matching maintainer. Store the
# same value in Vault as kael_matching_maintainer_secret before scheduling it.
KAEL_MATCHING_MAINTAINER_SECRET=
KAEL_TRUST_PERPLEXITY_FILTER_ENABLED=
KAEL_OPT_SOURCE_TRUST_ENABLED=
# §40 S3: deployment config for the higher source-evidence quorum; unset fails closed.
KAEL_SOURCE_TRUST_HIGH_VALUE_VND=
# Smart-clarification intake-diagnosis (off = legacy hardcoded clarification)
KAEL_OPT_LLM_CLARIFICATION_ENABLED=
# S4/F1 (§38): global hard-stop for customer-facing AI in an incident (default off).
KAEL_AI_KILL_SWITCH=
KAEL_DURABLE_GUARDS_ENABLED=
# §40 M2: opt-in VND threshold for scope-change Opus escalation; unset = confidence-only.
KAEL_SCOPE_CHANGE_ESCALATION_VND=
KAEL_PERMISSION_CONFIDENCE_THRESHOLD=
# Per-user and global AI spend ceilings (USD). Defaults remain 30 / 1 / 5 when unset.
KAEL_AI_GLOBAL_DAILY_CAP_USD=
KAEL_AI_USER_DAILY_CAP_USD=
KAEL_AI_USER_MONTHLY_CAP_USD=
# Optional Kael operations alert target. Empty is an intentional no-op.
KAEL_OPS_ALERT_WEBHOOK_URL=

# Manual provider model-health probe; never committed with values.
KAEL_MODEL_HEALTH_TIMEOUT_MS=
KAEL_MODEL_HEALTH_MAX_RETRIES=
