{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nestscout.internal/schemas/harness-release-v1.json",
  "title": "NestScout Harness Release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "environment",
    "environmentBinding",
    "gitSha",
    "manifestSha256",
    "migrationInventorySha256",
    "migrationInventory",
    "databaseTypesSha256",
    "promptBundleSha256",
    "policyBundleSha256",
    "runtimeConfigurationSha256",
    "evaluationSuiteVersion",
    "evaluationSuiteSha256",
    "capabilityRegistrySha256",
    "accessMatrixSha256",
    "reliabilityPolicySha256",
    "promotionPolicySha256",
    "edgeFunctions",
    "edgeFunctionInputs",
    "verificationRequirements",
    "rollbackPolicy",
    "bundleSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "releaseId": {
      "type": "string",
      "pattern": "^harness-[0-9a-f]{12}-[0-9a-f]{12}$"
    },
    "environment": {
      "enum": [
        "local",
        "preview",
        "staging",
        "production"
      ]
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "manifestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "migrationInventorySha256": {
      "$ref": "#/$defs/sha256"
    },
    "databaseTypesSha256": {
      "$ref": "#/$defs/sha256"
    },
    "promptBundleSha256": {
      "$ref": "#/$defs/sha256"
    },
    "policyBundleSha256": {
      "$ref": "#/$defs/sha256"
    },
    "evaluationSuiteVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "edgeFunctions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "bundleSha256": {
      "$ref": "#/$defs/sha256"
    },
    "evaluationSuiteSha256": {
      "$ref": "#/$defs/sha256"
    },
    "capabilityRegistrySha256": {
      "$ref": "#/$defs/sha256"
    },
    "accessMatrixSha256": {
      "$ref": "#/$defs/sha256"
    },
    "reliabilityPolicySha256": {
      "$ref": "#/$defs/sha256"
    },
    "promotionPolicySha256": {
      "$ref": "#/$defs/sha256"
    },
    "environmentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerConfigurationClass",
        "webhookConfigurationClass"
      ],
      "properties": {
        "providerConfigurationClass": {
          "enum": [
            "local-development",
            "preview-isolated",
            "staging-isolated",
            "production-locked"
          ]
        },
        "webhookConfigurationClass": {
          "enum": [
            "local-loopback",
            "preview-disabled",
            "staging-sandbox",
            "production-signed"
          ]
        }
      }
    },
    "migrationInventory": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "version",
        "migrationCount",
        "migrationsSha256",
        "databaseTypes",
        "entries"
      ],
      "properties": {
        "version": {
          "const": "1.0.0"
        },
        "migrationCount": {
          "type": "integer",
          "minimum": 1
        },
        "migrationsSha256": {
          "$ref": "#/$defs/sha256"
        },
        "databaseTypes": {
          "type": "object",
          "required": [
            "file",
            "sha256"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "version",
              "name",
              "file",
              "sha256",
              "bytes"
            ],
            "properties": {
              "version": {
                "type": "string",
                "pattern": "^[0-9]{14}$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "file": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "runtimeConfigurationSha256": {
      "$ref": "#/$defs/sha256"
    },
    "edgeFunctionInputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verificationRequirements": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rollbackPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historicalMigrationsImmutable",
        "schemaCorrectionMode",
        "compatibilityStrategy"
      ],
      "properties": {
        "historicalMigrationsImmutable": {
          "const": true
        },
        "schemaCorrectionMode": {
          "const": "forward-migration"
        },
        "compatibilityStrategy": {
          "const": "expand-contract"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
