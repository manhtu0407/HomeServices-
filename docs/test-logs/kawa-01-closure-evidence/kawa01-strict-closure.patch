@@ -0,0 +1,136 @@
+// Deterministic emergency handling for Case intake turns. It runs before the boundary guard, the
+// intent router and the pipeline, and it does not depend on a playbook flag or on a model.
+
+import { sanitizeForLLM, type ServiceType } from "../../../../_shared/domain.ts";
+import { sanitizeCustomerCaseEvidenceText } from "../../kael/evidence/untrusted-evidence.ts";
+import {
+  resolveReportedEmergencyGuidance,
+  type EmergencyGuidance,
+} from "../../kael/kael-guardrails/emergency-guidance.ts";
+import { asKaelChatStatus, asNumber, asRecord } from "../../platform/coercions.ts";
+import type { DbClient } from "../../platform/db.ts";
+import { requiresImmediateKaelSafetyPath } from "./intake-safety.ts";
+import { appendKaelSystemTurn, insertKaelTurn, updateKaelSession } from "./session-store.ts";
+import { restoreAnsweredTurnState } from "./turn-intent-router.ts";
+
+export type CaseEmergency = {
+  readonly guidance: EmergencyGuidance;
+  // Fire, medical, police and unclear emergencies end the turn. A wiring or water hazard is advice
+  // the intake can continue after, so the Case still gets its next question.
+  readonly stopsTurn: boolean;
+};
+
+type CaseEmergencyInput = {
+  // One text, or every customer-authored text the request carries (a message, a skip reason, a transcript).
+  readonly message: string | readonly string[];
+  readonly language: "vi" | "en";
+  readonly serviceType: ServiceType;
+  readonly persistedSafetySignals?: readonly string[];
+  readonly actorId?: string | null;
+};
+
+export function resolveCaseEmergency(input: CaseEmergencyInput): CaseEmergency | null {
+  for (const message of typeof input.message === "string" ? [input.message] : input.message) {
+    const emergency = resolveTextEmergency(message, input);
+    if (emergency) return emergency;
+  }
+  return null;
+}
+
+function resolveTextEmergency(message: string, input: CaseEmergencyInput): CaseEmergency | null {
+  const guidance = resolveReportedEmergencyGuidance(message, input.language, { serviceType: input.serviceType });
+  if (!guidance) return null;
+  const hazardOnly = guidance.route === "electrical_water";
+  const flaggedPathOwnsHazard = guidance.route === "fire" || hazardOnly;
+  // When a service's flagged path already answers a smoke, fire or wiring hazard with its own
+  // deterministic guidance, that reply is the only safety message; a second one would repeat it.
+  if (
+    flaggedPathOwnsHazard &&
+    requiresImmediateKaelSafetyPath(
+      message,
+      input.serviceType,
+      input.persistedSafetySignals,
+      input.actorId,
+    )
+  ) return null;
+  return { guidance, stopsTurn: !hazardOnly };
+}
+
+// A Case that cannot take the turn yet still answers a reported emergency: its booking confirmation is
+// pending, analysis is deferred, or the price-question chip persists nothing. No flagged path or
+// pipeline step runs in those requests, so every reported route is answered here and the Case is
+// left exactly as it was.
+export function resolveParkedCaseEmergency(
+  messages: readonly string[],
+  language: "vi" | "en",
+  serviceType: string | null,
+): { readonly emergency: CaseEmergency; readonly message: string } | null {
+  for (const message of messages) {
+    const guidance = message ? resolveReportedEmergencyGuidance(message, language, { serviceType }) : null;
+    if (guidance) return { emergency: { guidance, stopsTurn: true }, message };
+  }
+  return null;
+}
+
+// Records what the customer said, then the deterministic reply. The booking confirmation is not
+// touched: only the customer decides it, through the intake-confirmation route.
+export async function answerEmergencyBeforeIntake(input: {
+  readonly client: DbClient;
+  readonly sessionId: string;
+  readonly session: Record<string, unknown>;
+  readonly messages: ReadonlyArray<string | undefined>;
+  readonly language?: "vi" | "en";
+}): Promise<boolean> {
+  const language = input.language ??
+    (asRecord(input.session.safe_metadata).language === "en" ? "en" : "vi");
+  const reported = resolveParkedCaseEmergency(
+    input.messages.map((message) => sanitizeForLLM(message ?? "")),
+    language,
+    typeof input.session.service_type === "string" ? input.session.service_type : null,
+  );
+  if (!reported) return false;
+  const turns = asNumber(input.session.total_turns);
+  await insertKaelTurn(input.client, {
+    session_id: input.sessionId,
+    turn_index: turns + 1,
+    role: "customer",
+    content_type: "text",
+    text_content: sanitizeCustomerCaseEvidenceText(reported.message),
+    media_refs: [],
+    safe_metadata: {},
+  });
+  await updateKaelSession(input.client, input.sessionId, { total_turns: turns + 1 });
+  await answerCaseEmergency(input.client, input.sessionId, reported.emergency, input.session);
+  // The reply must not move the Case to another phase: a Case waiting for evidence still waits for it.
+  if (asKaelChatStatus(input.session.status) === "collecting_evidence") {
+    await updateKaelSession(input.client, input.sessionId, { status: "collecting_evidence" });
+  }
+  return true;
+}
+
+export async function answerCaseEmergency(
+  client: DbClient,
+  sessionId: string,
+  emergency: CaseEmergency,
+  // The session as it stood before this turn parked it in analysis; supplied on follow-up turns so an
+  // offer under review and its recorded blocker are put back after a reply that re-analysed nothing.
+  previousSession?: Record<string, unknown>,
+) {
+  // The route code alone: a session or user identifier beside a health or police code would profile one person.
+  console.warn("kael_chat emergency route", { route: emergency.guidance.route });
+  await appendKaelSystemTurn(client, sessionId, {
+    contentType: "analysis",
+    text: emergency.guidance.response,
+    nextStatus: previousSession && asKaelChatStatus(previousSession.status) === "estimate_ready"
+      ? "estimate_ready"
+      : "active",
+    telemetry: { replySource: "template" },
+    metadata: {
+      safety_source: "deterministic_emergency",
+      emergency_route: emergency.guidance.route,
+    },
+  });
+  if (previousSession && emergency.stopsTurn) {
+    await restoreAnsweredTurnState({ client, sessionId, session: previousSession });
+  }
+}
diff --git a/supabase/functions/mobile-api/_shared/kael/kael-guardrails/emergency-signal-text.ts b/supabase/functions/mobile-api/_shared/kael/kael-guardrails/emergency-signal-text.ts
