    "harness:release:ledger-sql:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-node.ps1 --test scripts/harness/register-release.test.mjs",
    "harness:evaluate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-node.ps1 scripts/harness/evaluate-release.mjs",
    "harness:reliability:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-node.ps1 scripts/harness/reliability-registry.mjs",
    "harness:reliability:write": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-node.ps1 scripts/harness/reliability-registry.mjs --write",
    "harness:promotion:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-node.ps1 scripts/harness/promotion.mjs --check",
    "harness:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-node.ps1 scripts/harness/verify.mjs",
    "design:intelligence": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-node.ps1 scripts/design/kael-design-intelligence.mjs",
    "design:direction": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-node.ps1 scripts/design/kael-design-direction.mjs",
    "design:preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-node.ps1 scripts/design/kael-design-preflight.mjs",
    "design:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-node.ps1 scripts/design/check-design-adapters.mjs",
    "lint:structure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-node.ps1 scripts/lint-structure.mjs",
    "lint:comments": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-node.ps1 scripts/check-comment-discipline.mjs",
    "db:local:doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File docker/scripts/doctor.ps1",
    "db:local:up": "powershell -NoProfile -ExecutionPolicy Bypass -File docker/scripts/up.ps1",
    "db:local:down": "powershell -NoProfile -ExecutionPolicy Bypass -File docker/scripts/down.ps1",
    "db:local:reset": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-supabase.ps1 db reset",
    "db:local:test": "powershell -NoProfile -ExecutionPolicy Bypass -File docker/scripts/run-sql-tests.ps1",
    "db:local:types": "powershell -NoProfile -ExecutionPolicy Bypass -File docker/scripts/gen-types.ps1",
    "db:local:diff": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-supabase.ps1 db diff --local",
    "db:local:lint": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-supabase.ps1 db lint --local",
    "edge:check": "powershell -NoProfile -ExecutionPolicy Bypass -File docker/scripts/edge-check.ps1",
    "kael:eval:multi-turn": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-node.ps1 apps/api/scripts/kael-multi-turn-eval.mjs",
    "kael:redteam:live": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-node.ps1 apps/api/scripts/kael-live-redteam.mjs",
    "kael:model-health": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-node.ps1 apps/api/scripts/kael-model-health.mjs"
  },
  "reactDoctor": {
    "blocking": "none",
    "noScore": true,
    "share": false,
    "respectInlineDisables": true
  },
  "devDependencies": {
    "metro-runtime": "0.83.3",
    "react-doctor": "0.5.8",
    "turbo": "^2",
    "zod": "^4.4.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "sandbox/*"
  ]
}
