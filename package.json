{
  "name": "nestscout",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-turbo.ps1 build",
    "build:api": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-package-script.ps1 @nestscout/api build",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-turbo.ps1 dev",
    "doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-react-doctor.ps1 changed",
    "doctor:react": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-react-doctor.ps1",
    "doctor:react:changed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-react-doctor.ps1 changed",
    "preview:mobile:web:staging": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-mobile-web-staging-preview.ps1",
    "kael:eval": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-node.ps1 apps/api/scripts/kael-eval.mjs",
    "kael:eval:playbook": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-node.ps1 apps/api/scripts/kael-playbook-eval.mjs",
    "lint": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-turbo.ps1 lint",
    "lint:api": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-package-script.ps1 @nestscout/api lint",
    "lint:mobile": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-package-script.ps1 @nestscout/mobile lint:mobile",
    "sandbox:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-package-script.ps1 @nestscout/sandbox test",
    "sandbox:type-check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-package-script.ps1 @nestscout/sandbox type-check",
    "supabase": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-supabase.ps1",
    "supabase:agent": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-supabase.ps1 --agent yes",
    "supabase:version": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-supabase.ps1 --version",
    "test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-turbo.ps1 test",
    "test:api": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-package-script.ps1 @nestscout/api test",
    "test:mobile": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-package-script.ps1 @nestscout/mobile test",
    "test:sandbox": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-package-script.ps1 @nestscout/sandbox test",
    "test:shared": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-package-script.ps1 @nestscout/shared test",
    "type-check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-turbo.ps1 type-check",
    "type-check:api": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-package-script.ps1 @nestscout/api type-check",
    "type-check:mobile": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-package-script.ps1 @nestscout/mobile type-check",
    "type-check:sandbox": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-package-script.ps1 @nestscout/sandbox type-check",
    "type-check:shared": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-package-script.ps1 @nestscout/shared type-check",
    "skills:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-node.ps1 scripts/sync-skills.mjs",
    "skills:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-node.ps1 scripts/check-skills-sync.mjs",
    "harness:manifest:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-node.ps1 scripts/harness/check-manifest.mjs",
    "harness:manifest:hash": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-node.ps1 scripts/harness/hash-manifest.mjs",
    "harness:manifest:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-node.ps1 --test scripts/harness/check-manifest.test.mjs",
    "harness:capabilities:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-node.ps1 scripts/harness/capability-registry.mjs",
    "harness:capabilities:write": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-node.ps1 scripts/harness/capability-registry.mjs --write",
    "harness:privileged:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-node.ps1 scripts/harness/check-privileged-clients.mjs",
    "harness:access:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-node.ps1 scripts/harness/access-matrix.mjs",
    "harness:access:write": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-node.ps1 scripts/harness/access-matrix.mjs --write",
    "harness:migrations:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-node.ps1 scripts/harness/migration-inventory.mjs",
